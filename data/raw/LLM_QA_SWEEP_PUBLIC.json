  "sampling": "temperature 0 · 3 samples/cell · majority vote (threshold 2) · no tools",
  "cells": 222,
  "model_calls": 666,
  "languages": 37,
  "prompt": "Using ONLY the context below, list the names of the functions that directly call `target`. Answer with ONLY a comma-separated list of function names, nothing else. If the context does not list caller names, answer with an empty line.\n\nCONTEXT:\n<context>",
